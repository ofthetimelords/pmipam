@using Vtable.PmIpam.ViewModels
@model RowTDModel

@if (this.Model.SectionTableRow < 3)
{
    <td class="@this.Model.RowStyle vlan@(this.Model.Vlan.VlanId)-@(this.Model.VlanSectionIndex) @(
            (this.Model.SectionTableRow == 0 ? "sectionname" : string.Empty) + " " + (this.Model.SectionTableRow == 1 ? "sectioncidr" : string.Empty)
        ) col2" rowspan="@(this.Model.SectionTableRow == 2 ? this.Model.TotalHostsInSection - 2 : 1)">
        <span>
            @if (this.Model.SectionTableRow == 0)
            {
                @this.Model.Section.Name
            }
            else if (this.Model.SectionTableRow == 1)
            {
                @this.Model.Section.Cidr
            }
        </span>

    </td>
}