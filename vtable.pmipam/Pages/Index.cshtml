@page
@model Vtable.PmIpam.Views.IndexModel
@using Vtable.PmIpam.Models
@using Vtable.PmIpam.ViewModels
@using System.Drawing


<html>
<head>
    <title>Poor Man's IPAM</title>
    <link rel="stylesheet" href="/static/style.css" />
    <style>
        @foreach (var vlan in this.Model.Root.Vlans)
        {
            <text>
            td.vlan@(vlan.VlanId) {
                background-color: @ColorTranslator.ToHtml(vlan.BaseColor);
                @this.Model.GetForeColor(vlan.BaseColor)
            }
            </text>

            int sections = vlan.Sections.Count + 1;

            if (sections != 0)
            {
                Color startColor = vlan.BaseColor;
                Color endColor = vlan.EndColor;
                int rStep = (startColor.R - endColor.R) / sections;
                int gStep = (startColor.G - endColor.G) / sections;
                int bStep = (startColor.B - endColor.B) / sections;

                for (int section = 1; section < sections; section++)
                {
                    var calcColor = Color.FromArgb(startColor.R - rStep * section, startColor.G - gStep * section, startColor.B - bStep * section);
                    <text>
                    td.vlan@(vlan.VlanId + "-" + section) {
                        background-color: @(ColorTranslator.ToHtml(calcColor));
                        @this.Model.GetForeColor(calcColor)
                    }
                    </text>
                }
            }
        }
    </style>
</head>
<body>
    <h1>Poor man's IPAM</h1>
    <div class="table-container">
        <div class="table-scroll-box">
            <table>
                <thead>
                    <tr>
                        <th>VLAN</th>
                        <th>Section</th>
                        <th>Device</th>
                        <th>IP Address
                                            <div class="ipPopup">
                        Total Hosts: @this.Model.Root.Vlans.SelectMany(v => v.Sections.Where(s => s.Hosts is not null).SelectMany(s => s.Hosts)).Count()
                    </div>
</th>
                        <th>HA</th>
                        <th>Status</th>
                        <th>DHCP <br />assign</th>
                        <th>Metrics</th>
                        <th>Notes</th>
                        <th>TODO</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var hostRowIndex = 0;
                        //var stotalHostCount = this.Model.Root.Vlans.SelectMany(v => v.Sections.Where(s => s.Hosts is not null).SelectMany(s => s.Hosts)).Count();
                    
                        foreach (var vlan in this.Model.Root.Vlans)
                        {
                            int vlanRowIndex = 0;
                            int hostsInVlan = vlan.Sections.Where(s => s.Hosts is not null).SelectMany(s => s.Hosts).Count();
                            int sectionIndex = 0;

                            @foreach (var sect in vlan.Sections)
                            {
                                sectionIndex++;
                                int sectRowIndex = 0;
                                int hostsInSection = sect?.Hosts?.Count ?? 2;

                                @foreach (var host in sect.Hosts)
                                {
                                    var rowStyle = string.Empty;
                                        var vlanRowStyle = string.Empty;

                                    if (hostRowIndex != 0)
                                    {
                                        if (vlanRowIndex == 0)
                                            vlanRowStyle = rowStyle = "vlansplit";
                                        else if (vlanRowIndex != 0 && sectRowIndex == 0)
                                            rowStyle = "sectionsplit";
                                    }

                                    <tr>
                                        @{
                                            var rowModel = new RowTDModel
                                            {
                                                Vlan = vlan,
                                                Section = sect,
                                                Host = host,
                                                VlanTableRow = vlanRowIndex,
                                                SectionTableRow = sectRowIndex,
                                                HostTableRow = hostRowIndex,
                                                VlanSectionIndex = sectionIndex,
                                                TotalHostsInSection = hostsInSection,
                                                TotalHostsInVlan = hostsInVlan,
                                                RowStyle = rowStyle,
                                                VlanRowStyle = vlanRowStyle
                                            };
                                        }
                                        @await Html.PartialAsync("_VlanTD", rowModel)
                                        @await Html.PartialAsync("_SectionTD", rowModel)
                                        @await Html.PartialAsync("_HostTDs", rowModel)

                                    </tr>

                                    vlanRowIndex++;
                                    sectRowIndex++;
                                    hostRowIndex++;
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
